<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <appSettings>
    <!-- Putanja do foldera sa Kelmarsh CSV fajlovima (Kelmarsh_1 ... Kelmarsh_6) -->
    <add key="ScadaDataPath" value="Data" />
  </appSettings>

  <system.serviceModel>
    <client>
      <endpoint name="WindTurbineService"
                address="net.tcp://localhost:5000/WindTurbineService"
                binding="netTcpBinding"
                bindingConfiguration="WindTurbineNetTcpBinding"
                contract="Common.IWindTurbineService" />
    </client>

    <bindings>
      <netTcpBinding>
		  <binding name="WindTurbineNetTcpBinding"
		   transferMode="Streamed"
		   maxReceivedMessageSize="67108864"
		   receiveTimeout="00:10:00"
		   sendTimeout="00:10:00"
		   openTimeout="00:01:00"
		   closeTimeout="00:01:00" />
      </netTcpBinding>
    </bindings>
  </system.serviceModel>
</configuration>
