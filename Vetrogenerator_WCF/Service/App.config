<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!-- ── Podešavanja aplikacije (pragovi, putanje) ──────────────────────── -->
  <appSettings>
    <!-- Direktorijum gde se čuvaju primljeni SCADA fajlovi. Kreira se automatski.
         Struktura: Data/<TurbineId>/<YYYY-MM-DD>/session.csv -->
    <add key="DataPath" value="Data" />

    <!-- Analitika 1 — Performanse (Power vs Potential) -->
    <add key="UnderPerformanceAlpha"      value="0.75" />

    <!-- Analitika 2 — Yaw misalignment -->
    <add key="YawMisalignThresholdDeg"    value="15" />

    <!-- Analitika 2 — Frekvencija mreže -->
    <add key="FrequencyDeviationAbsHz"    value="0.5" />
    <add key="FrequencySpikeThresholdHz"  value="0.2" />
  </appSettings>

  <!-- ── WCF Service host ───────────────────────────────────────────────── -->
  <system.serviceModel>
    <services>
      <service name="Service.WindTurbineService">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:5000" />
          </baseAddresses>
        </host>
        <endpoint
          address="WindTurbineService"
          binding="netTcpBinding"
          bindingConfiguration="WindTurbineNetTcpBinding"
          contract="Common.IWindTurbineService" />
      </service>
    </services>

    <bindings>
      <netTcpBinding>
		  <binding name="WindTurbineNetTcpBinding"
		   transferMode="Streamed"
		   maxReceivedMessageSize="67108864"
		   receiveTimeout="00:10:00"
		   sendTimeout="00:10:00"
		   openTimeout="00:01:00"
		   closeTimeout="00:01:00" />
      </netTcpBinding>
    </bindings>
  </system.serviceModel>
</configuration>
